{
  "name": "@cogniswarm/collector",
  "version": "0.1.0",
  "description": "CogniSwarm behavioral telemetry collector — consent-gated, off-main-thread feature extraction.",
  "type": "module",
  "main": "dist/cogniswarm.min.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --global-name=CogniSwarm --outfile=dist/cogniswarm.min.js",
    "build:dev": "esbuild src/index.ts --bundle --format=iife --global-name=CogniSwarm --outfile=dist/cogniswarm.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
