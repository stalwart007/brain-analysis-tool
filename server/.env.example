# Copy this file to `.env` and paste your key. `.env` is gitignored.
#   cp .env.example .env
# Then start the server with:
#   ./run.sh

OPENAI_API_KEY=sk-paste-your-new-key-here

# ── Analysis-surface auth. NOT optional: the server FAILS CLOSED. ──────────
# `require_api_key` refuses to serve /v1/* unless one of these two is set,
# because an auth check whose failure mode is "allow everything" is not an
# auth check — an unset variable would otherwise publish sessions, panel
# members, run history (with every twin's inner monologue) and every endpoint
# that spends OpenAI credit. With neither set you get 503 on every endpoint.
#
# Local development: open, but explicitly chosen rather than defaulted into.
COGNISWARM_ALLOW_ANONYMOUS=1
#
# Anything else: set real keys instead and leave ALLOW_ANONYMOUS unset.
# Configured keys always win, so this can never be weakened by the line above.
# COGNISWARM_API_KEYS=key1,key2

# Optional overrides:
# COGNISWARM_PROFILER_MODEL=gpt-4o
# COGNISWARM_TWIN_MODEL=gpt-4o-mini
# COGNISWARM_CONCURRENCY=8
# COGNISWARM_DB=/data/cogniswarm.db
