# Copy this file to `.env` and paste your key. `.env` is gitignored.
#   cp .env.example .env
# Then start the server with:
#   .venv/bin/uvicorn app.main:app --app-dir . --port 8000 --env-file .env

OPENAI_API_KEY=sk-paste-your-new-key-here

# Optional overrides:
# COGNISWARM_PROFILER_MODEL=gpt-4o
# COGNISWARM_TWIN_MODEL=gpt-4o-mini
# COGNISWARM_API_KEYS=some-shared-secret   # locks the headless API surface
