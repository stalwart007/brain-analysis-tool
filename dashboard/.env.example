# Copy to `.env.local`. All of these are read server-side only — none reach
# the browser.

# Signs the session cookie. The app REFUSES TO START in production without it.
#   openssl rand -base64 32
AUTH_SECRET=generate-me-with-openssl-rand-base64-32

# Where the FastAPI backend lives. The dashboard proxies /api/cs/* to it
# server-side, so the backend never needs to be reachable from the browser —
# in production keep it on a private network.
COGNISWARM_BACKEND=http://127.0.0.1:8000

# The backend's X-API-Key, injected by the proxy so the browser never sees it.
# Must match one of the server's COGNISWARM_API_KEYS. Leave unset only when the
# server runs with COGNISWARM_ALLOW_ANONYMOUS=1.
# COGNISWARM_API_KEY=key1
